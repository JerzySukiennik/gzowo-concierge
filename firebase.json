{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }
    ]
  }
}
